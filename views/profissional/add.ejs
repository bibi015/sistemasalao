<%- include('../cabecalho.ejs') %>
<h1>Cadastrar Profissional</h1>
<a href="/profissional/lst">Voltar para lista</a><br><br>
<form method="post" action="/profissional/add">
<label>Nome:</label><input type="text" name="nome" required><br><br>
<label>Especialidade:</label><input type="text" name="especialidade" required><br><br>
<label>Clientes:</label><% clientes.forEach(cliente => { %><div><input type="checkbox" name="clientes" value="<%= cliente._id %>"><label><%= cliente.nome %></label></div><% }) %><br>
<button type="submit">Cadastrar</button></form>
<%- include('../rodape.ejs') %>
