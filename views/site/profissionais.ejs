<!doctype html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Conheça as profissionais do Lume Salão & Beleza.">
  <title>Profissionais | Lume</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
  <div class="topbar">
    <div class="shell"><span>Beleza com tempo, cuidado e intenção.</span><span>Ter–Sáb: 9h às 19h</span></div>
  </div>
  <header class="site-header">
    <div class="shell nav"><a class="brand" href="/site"><span class="brand-mark">L</span><span
          class="brand-copy"><strong>Lume</strong><small>salão & beleza</small></span></a>
      <nav class="nav-links" aria-label="Navegação principal"><a href="/site">Início</a><a
          href="/site/servicos">Serviços</a><a href="/site/profissionais" aria-current="page">Profissionais</a><a
          href="/site/pacotes">Pacotes</a><a href="/site/agendar">Agendar</a></nav><a
        class="button button-primary header-cta" href="/site/agendar">Agendar horário</a>
    </div>
  </header>
  <main id="conteudo">
    <section class="page-hero">
      <div class="shell"><span class="eyebrow">Nosso time</span>
        <h1>Mãos que cuidam,<br><em>talentos que transformam</em></h1>
        <p>Conheça as profissionais que fazem de cada visita ao Lume uma experiência especial.</p>
      </div>
    </section>
    <section class="section">
      <div class="shell">
        <div class="professional-grid">
          <% if (profissionais.length) { %>
            <% for (const profissional of profissionais) { %>
              <article class="professional-card">
                <div class="professional-avatar" aria-hidden="true">
                  <%= profissional.nome.trim().charAt(0).toUpperCase() %>
                </div>
                <div class="professional-info"><span>
                    <%= profissional.especialidade %>
                  </span>
                  <h3>
                    <%= profissional.nome %>
                  </h3>
                </div>
              </article>
              <% } %>
                <% } else { %>
                  <p class="empty-state">Nossa equipe será apresentada em breve.</p>
                  <% } %>
        </div>
      </div>
    </section>
    <section class="cta">
      <div class="shell">
        <h2>Escolha quem vai cuidar do seu próximo momento.</h2><a class="button" href="/site/agendar">Agendar agora</a>
      </div>
    </section>
  </main>
  <footer class="footer">
    <div class="shell footer-grid">
      <div><a class="brand" href="/site"><span class="brand-mark">L</span><span
            class="brand-copy"><strong>Lume</strong><small>salão & beleza</small></span></a>
        <p class="footer-intro">Um espaço feito para você se cuidar, respirar e florescer.</p>
      </div>
      <div>
        <h3>Explore</h3><a href="/site/servicos">Serviços</a><a href="/site/profissionais">Profissionais</a><a
          href="/site/pacotes">Pacotes</a>
      </div>
      <div>
        <h3>Atendimento</h3>
        <p>Ter–Sáb: 9h às 19h</p>
        <p>(11) 99999-1234</p>
      </div>
      <div>
        <h3>Onde estamos</h3>
        <p>Rua das Flores, 128<br>Jardins · São Paulo</p>
      </div>
    </div>
    <div class="shell footer-bottom"><span>© 2026 Lume Salão & Beleza</span><span>Feito com cuidado para você.</span>
    </div>
  </footer>
</body>

</html>